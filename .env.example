# Placeholders only. Real secrets live in deploy/secrets/ (Docker secrets), never in this file.
SITE_ADDRESS=security.example.internal

# Local API development (no Docker)
SP_ENVIRONMENT=development
SP_DATABASE_URL=postgresql+asyncpg://platform_app@localhost:5432/platform
SP_DATABASE_PASSWORD_FILE=./deploy/secrets/pg_app_password
SP_REDIS_URL=redis://localhost:6379/0
SP_MASTER_KEY_FILE=./deploy/secrets/master_key
SP_REDACTION_SALT_FILE=./deploy/secrets/redaction_salt
SP_COOKIE_SECURE=false
